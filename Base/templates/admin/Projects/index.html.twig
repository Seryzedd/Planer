{% extends 'base.html.twig' %}

{% block title %}{% trans %}Admin projects{% endtrans %}{% endblock %}

{% block breadcrumb %}
    {% set content = {
        'Admin': 'admin_index',
        'Projects': ''
        } 
    %}

    {{ parent() }}
{% endblock %}

{% block body %}
    <div class="w-100">
        {% if form %}
            <h1 class="text-secondary d-flex justify-content-between">
                {% trans %}Projects list{% endtrans %}
                <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#createProjectModal">
                    {% trans %}New{% endtrans %}
                </button>
            </h1>

            {% include 'Partials/FilterSortForms.html.twig' with {'filterValue': 'project', 'sortOptions': {'': 'None', 'status': 'Status', 'name': 'Name', 'deadline': 'Deadline'}} %}

            <!-- Modal -->
            <div class="modal fade" id="createProjectModal" tabindex="-1" role="dialog" aria-labelledby="modalTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="text-secondary" id="modalTitle">{% trans %}Create Project{% endtrans %}</h5>
                        <button type="button" class="close" title='{% trans %}Close{% endtrans %}' data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <div class="modal-body">
                        {{ form_start(form) }}
                        {{ form_end(form) }}
                    </div>
                    </div>
                </div>
            </div>
        {% else %}
            <h1 class="text-secondary">
                {% trans %}Projects list{% endtrans %}
            </h1>
        {% endif %}

        {% for project in projects %}
            <div class="row align-items-center border rounded px-2 py-1 mb-1 bg-light" filter-data="{{ [(project.name ?: 'Anonymous'|trans), project.status, (project.client.name ?: 'Anonymous'|trans)]|filterParams }}">
                
                <div class="col-lg-2">
                    <p class="mb-0">
                        <a href="{{ path('admin_project_view', {'id': project.id}) }}" class="btn btn-link"><strong>{{ project.name ?: 'Anonymous'|trans }}</strong></a>
                    </p>
                </div>

                <div class="col-lg-6">
                    {% include 'Partials/steps.html.twig' with {'steps': constant('App\\Entity\\Client\\Project::STATUS_LIST'), 'currentStep': project.status} %}
                    {% if not project.lastStatus %}
                        <p class='text-center mb-0 mt-1'>
                            <a class="btn btn-light btn-sm btn-block" href="{{ path('admin_project_status_next', {'id': project.id}) }}">
                                <i class="fa-solid fa-arrow-right-long"></i>
                            </a>
                        </p>
                    {% endif %}
                    
                </div>

                <div class="col-lg-2">
                    <button class="btn btn-light mx-auto" type="button" data-bs-toggle="collapse" data-bs-target="#collapseAssignations_{{ project.id }}" aria-expanded="false" aria-controls="collapseAssignations">
                        {% trans %}assignations{% endtrans %}
                    </button>
                </div>

                <div class="col-lg-2 text-end">
                    <a href="{{ path('admin_project_translate', {'id': project.id}) }}" class="btn btn-light" title="{% trans %}Translate project{% endtrans %}">
                        <i class="fa-solid fa-language"></i>
                    </a>
                </div>

                <div class='col-12 collapse' id="collapseAssignations_{{ project.id }}">
                    <div class="row align-items-center">
                        <div class="col-lg-2">
                            <p class="mb-0 text-muted">
                                {{ project.deadline|instanceOf('\Datetime') ? project.deadline|date('d/m/Y') : 'No deadline'|trans }}
                            </p>
                        </div>
                        <div class="col-lg-6">
                            <p class="mb-0 text-muted">
                                {{ project.description ?: 'No description'|trans }}
                            </p>
                        </div>

                        <div class="col-lg-2">
                            <p class="mb-0">{{ project.client.name }}</p>
                        </div>

                        <div class="col-lg-2">
                            <p class="mb-0">
                                <img src="{{ project.client.logo }}" class="img-fluid max-w-100"/>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}