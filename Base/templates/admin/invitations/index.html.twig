{% extends 'base.html.twig' %}

{% block title %}{% trans %}Admin Users{% endtrans %}{% endblock %}

{% block breadcrumb %}
    {% set content = {
        'Admin': 'admin_index',
        'Invitations': ''
    } %}

    {{ parent() }}
{% endblock %}

{% block body %}
    <div class=''>
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h1 class="text-primary">{% trans %}Inviations{% endtrans %}</h1
            {% if app.user.company %}
                <div>
                    {{ form_start(form) }}
                    {{ form_end(form)}}
                </div>
            {% endif %}
        </div>
        
        <div class='rounded bg-light py-2 px-4'>
            <h3 class='text-secondary px-2'>{% trans %}Invitations list{% endtrans %}</h3>

            <p class='text-muted'>{% trans with {'%company%': app.user.company ? app.user.company.name : 'Anonymous'|trans}  %}Suggest Users to join your %company%{% endtrans %}.</p>

            {% if invitations|length == 0 %}
                <h2 class="text-muted text-center">{% trans %}No Invitation created.{% endtrans %}</h2>
            {% else %}
                {% include 'Partials/FilterSortForms.html.twig' with {'filterValue': 'project', 'sortOptions': {'': 'None', 'Email': 'email', 'Status': 'status', 'date': 'Created date'}} %}
            {% endif %}

            {% for invitation in invitations %}
                <div class='row bg-light bg-white align-items-center text-center border py-2 mb-1' {{ [invitation.email, invitation.status, invitation.date|date('d/m/Y'), invitation.valid]|filterParams }}>
                    <div class='col-12 order-3 order-lg-1 col-lg-3 mb-lg-0 mb-1 text-dark'>
                        {% if is_granted('ROLE_SUPER_ADMIN') %}
                            <h4 class="text-secondary mb-0">{{ invitation.company.name ?: 'Anonymous'|trans }}</h4>
                        {% endif %}
                        
                        {{ invitation.email }}
                    </div>

                    <div class='col-12 order-4 col-md-4 col-lg-2 mb-lg-0 mb-1 text-primary'>
                        <p class="text-primary justify-content-center mb-0 d-flex align-items-center">
                            <span class="text-truncate border rounded-left py-1 px-2" id="invitation_code_{{ invitation.id }}">{{ invitation.code }}</span>
                            <button role="button" class="btn-light btn copy-btn rounded-start-0 rounded-end py-1" copied-message="{% trans %}Invitation code Copied.{% endtrans %}" data-target="#invitation_code_{{ invitation.id }}">
                                <i class="far fa-copy"></i>
                            </button>
                        </p>
                    </div>
                    
                    <div class='col-12 order-4 order-lg-3 col-lg-4 col-md-8 text-truncate'>
                        <p class="text-muted justify-content-center mb-0 d-flex align-items-center">
                            <span class="text-wrap border rounded-left p-1" id="invitation_url_{{ invitation.id }}">{{ url('app_invitation_validate', {'id': invitation.id}) }}</span>
                            <button role="button" class="btn-light btn copy-btn rounded-start-0 rounded-end py-1" copied-message="{% trans %}Url Copied.{% endtrans %}" data-target="#invitation_url_{{ invitation.id }}">
                                <i class="far fa-copy"></i>
                            </button>
                        </p>
                    </div>

                    <div class='col-lg-2 col-6 order-1 order-lg-4'>
                        <p class="mb-0 text-start">
                            {% if invitation.status == constant("App\\Entity\\Invitation::VALID_STATUS") %}
                                <span class='bg-success text-light rounded text-nowrap mb-2 p-1'>{{ invitation.status|trans }}</span>
                            {% else %}
                                <span class='bg-danger text-light rounded p-2'>{{ invitation.status|trans }}</span>
                            {% endif %}

                            {% if invitation.valid %}
                                <span class='bg-success text-light rounded text-nowrap p-1'>{{ "In time"|trans }}</span>
                            {% else %}
                                <span class='bg-danger text-light rounded p-2'>{{ 'Outdated'|trans }}</span>
                            {% endif %}
                        </p>
                    </div>

                    <div class='col-lg-1 col-6 text-right order-2 order-lg-4 mt-2 text-end'>
                        {% if invitation.status == constant("App\\Entity\\Invitation::VALID_STATUS") %}
                            <a href="{{ path('admin_cancel_invitation', {id: invitation.id}) }}" class="btn btn-light" title="{% trans %}Cancel{% endtrans %}"><i class="fas fa-ban"></i></a>
                        {% else %}
                            <a href="{{ path('admin_reactive_invitation', {id: invitation.id}) }}" class="btn btn-outline-success" title="{% trans %}Activate{% endtrans %}"><i class="fas fa-walking"></i></a>
                        {% endif %}
                        
                        <a href="{{ path('admin_remove_invitation', {id: invitation.id}) }}" class="btn btn-outline-danger" title="{% trans %}Remove{% endtrans %}"><i class="fas fa-trash-alt"></i></a>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}