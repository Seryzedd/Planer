{% extends 'base.html.twig' %}

{% block title %}{% trans %}Welcome on Planer{% endtrans %}{% endblock %}

{% block breadcrumb %}
    {% set content = {
        'Home': 'app_index'
        } %}

    {{ parent() }}
{% endblock %}

{% block body %}
    

    <div>
        <div class="d-flex justify-content-between align-items-center">
            <h2 class="text-secondary">{% trans %}My calendar{% endtrans %}</h2>
            <a class="btn btn-link" href="{{ path('app_calendar_index') }}">{% trans %}Go to calendar{% endtrans %}</a>
        </div>
        

        {% include "Calendar/view.html.twig" with {'users': [app.user]} %}
    </div>

    <div class="row border-top">
        <div class="col-md-6">
            {{ block('events') }}
        </div>

        <div class="col-md-6 pt-2">
            <h2 class="text-secondary mt-2">{% trans %}My company clients{% endtrans %}</h2>
            {% include "Partials/clients_logos_cloud.html.twig" with {'list': clients} %}
        </div>
    </div>
    

{% endblock %}

{% block events %}
    {% set weeks = weeks('now'|date('d-m-Y'), app.user) %}
    <div class="border-end pt-2 mt-2">
        <div class="d-flex justify-content-between align-items-center">
            <h2 class="text-secondary">{% trans %}My week events{% endtrans %}</h2>
            <a class="btn btn-link" href="{{ path('app_calendar_event') }}">{% trans %}Go to events{% endtrans %}</a>
        </div>
        
        {% include "calendar_event/EventCalendar.html.twig" with {'weeks': weeks} %}
    </div>
{% endblock %}